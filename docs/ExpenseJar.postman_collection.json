						"method": "GET",
						"url": { "raw": "http://localhost:8080/api/users/1/trend?months=6", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "users", "1", "trend"], "query": [{ "key": "months", "value": "6" }] }
					}
				},
				{
					"name": "Backend Dashboard Stats",
					"request": {
						"method": "GET",
						"url": { "raw": "http://localhost:8080/api/dashboard", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "dashboard"] }
