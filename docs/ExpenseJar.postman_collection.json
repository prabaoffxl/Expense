				},
				{
					"name": "Active Budget Alerts (>90% Spend)",
					"request": {
						"method": "GET",
						"url": { "raw": "http://localhost:8080/api/users/1/alerts", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "users", "1", "alerts"] }
